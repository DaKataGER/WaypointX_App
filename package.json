{
  "name": "waypointx-app",
  "productName": "Waypoint X",
  "version": "1.1.0",
  "description": "Waypoint X – Mitarbeiter-App",
  "author": "Waypoint X",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.waypointx.app",
    "productName": "Waypoint X",
    "copyright": "Waypoint X",
    "files": [
      "main.js",
      "config.json",
      "laden.html",
      "fehler.html",
      "emblem.png",
      "icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "WaypointX-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Waypoint X",
      "uninstallDisplayName": "Waypoint X",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DaKataGER",
        "repo": "WaypointX_App",
        "releaseType": "release"
      }
    ]
  }
}
